# ========================================================
# DIGITAL SEVA — ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and configure your values.
# NEVER commit the actual .env file or production secrets to Git.
# ========================================================

# Server Environment Mode
# Set to 'production' on hosted environments (Render) to enforce strict security checks.
NODE_ENV=development

# Server Port and Host
# Note: Render automatically assigns PORT (usually 10000); leave default for local dev.
PORT=8000
HOST=0.0.0.0

# Authorized Business Owner Secret Key / Token
# Used to authenticate owner access to /admin.html and private document APIs.
# In production (NODE_ENV=production), must be at least 32 characters long.
# Development fallback: ds_local_dev_only_key (strictly rejected in production).
ADMIN_TOKEN=your_secure_random_admin_token_minimum_32_characters_here

# Private Document & Enquiry Storage Directory
# Local development: 'uploads' (resolves to ./uploads relative to project root).
# Hosted / Render with Persistent Disk: Absolute mount path (e.g. '/var/data').
STORAGE_DIR=uploads

# Customer Record Retention Policy in Days
# Automatically purges completed customer records and associated files older than N days.
# Set to 0 to disable automatic expiry (records retained permanently until manual deletion).
RETENTION_DAYS=90

# ========================================================
# AUTOMATIC EMAIL NOTIFICATIONS FOR NEW ENQUIRIES
# Notifications are disabled by default until explicitly enabled below.
# ========================================================
EMAIL_NOTIFICATIONS_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_username_here
SMTP_PASS=your_smtp_app_password_here
EMAIL_FROM="Digital Seva Notifications" <no-reply@example.com>
NOTIFICATION_EMAIL=digitalseva7051@gmail.com
