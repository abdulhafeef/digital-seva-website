# ========================================================
# DIGITAL SEVA — ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env (for local Node server) or .dev.vars (for Cloudflare Wrangler).
# Configure production secrets in the Cloudflare Dashboard / Supabase Project settings.
# NEVER commit .env, .dev.vars, or production credentials to Git.
# ========================================================

# Server Environment Mode
# Set to 'production' on hosted environments to enforce strict security checks.
NODE_ENV=development

# Server Port and Host (Used by local Node development server)
PORT=8000
HOST=0.0.0.0

# --------------------------------------------------------
# 1. SUPABASE DATABASE & PRIVATE STORAGE CONFIGURATION
# Obtain from Supabase Project Settings -> API
# --------------------------------------------------------
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_public_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key_here

# --------------------------------------------------------
# 2. OWNER AUTHENTICATION & SECURE SESSION TOKENS
# Used to authenticate owner access to /admin.html and private document APIs.
# In production (NODE_ENV=production), both secrets MUST be at least 32 characters long.
# --------------------------------------------------------
ADMIN_TOKEN=your_secure_random_admin_token_minimum_32_characters_here
SESSION_SECRET=your_secure_random_session_secret_minimum_32_characters_here

# --------------------------------------------------------
# 3. CUSTOMER RECORD RETENTION POLICY
# Automatically purges completed customer records and associated files older than N days.
# Set to 0 to disable automatic expiry (records retained permanently until manual deletion).
# --------------------------------------------------------
RETENTION_DAYS=90

# --------------------------------------------------------
# 4. CLOUDFLARE TURNSTILE CAPTCHA (BOT PROTECTION)
# Obtain from Cloudflare Dashboard -> Turnstile
# Optional for local development; required for public deployment.
# --------------------------------------------------------
TURNSTILE_SITE_KEY=your_cloudflare_turnstile_site_key_here
TURNSTILE_SECRET_KEY=your_cloudflare_turnstile_secret_key_here

# --------------------------------------------------------
# 5. AUTOMATIC EMAIL NOTIFICATIONS (HTTP API via Resend)
# Notifications are disabled by default until explicitly enabled below.
# --------------------------------------------------------
EMAIL_NOTIFICATIONS_ENABLED=false
RESEND_API_KEY=re_your_resend_api_key_here
EMAIL_FROM="Digital Seva Notifications" <onboarding@resend.dev>
NOTIFICATION_EMAIL=digitalseva7051@gmail.com

# --------------------------------------------------------
# 6. LOCAL NODE.JS DEV STORAGE DIRECTORY (Fallback)
# --------------------------------------------------------
STORAGE_DIR=uploads
