# ========================================================
# DIGITAL SEVA — ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and configure your production values.
# NEVER commit the actual .env file or production secrets to Git.
# ========================================================

# Server Port and Host
PORT=8000
HOST=0.0.0.0

# Authorized Business Owner Secret Key / Token
# Used to authenticate owner access to the /admin.html dashboard and private documents API.
ADMIN_TOKEN=your_secure_admin_password_or_token_here

# Private Document Upload Directory
# Note: uploads/ is strictly excluded in .gitignore and protected from public HTTP access.
STORAGE_DIR=uploads

# Customer Record Retention Policy in Days (0 = permanent until manual deletion)
RETENTION_DAYS=90
